# ============================================================
# Viora 根目录忽略规则
# ============================================================

# ---- PlatformIO 编译产物 ----
.pio/

# ---- 第三方组件 / 大体积下载包 ----
# 全新克隆后运行 scripts/fetch_components.py 自动恢复
components/*.zip
components/esp-sr/
components/esp-dsp/
components/esp-tflite-micro/
components/esp-nn/
components/esp-dsp147/
components/srmodels.bin
components/srmodels_stage/
components/esp-sr/lib/esp32s3_merged/

# ---- VS Code ----
# tasks.json / settings.json 入库共享；其余机器相关配置忽略
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# ---- 敏感配置（模板见 src/secrets.example.h，新克隆复制改名）----
src/secrets.h

# ---- 服务端 ----
# 整体不跟踪；VioraServer/ 内有自己的 .gitignore，未来拆成独立仓库时生效
VioraServer/

# ---- 日志与临时文件 ----
*.log

# ---- AI 助手缓存 ----
.claude/
.codex/

# ---- macOS ----
.DS_Store
