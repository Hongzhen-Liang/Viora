# ============================================================
# Hi Vesper 唤醒词训练流水线配置
# 复制为 .env 后修改；run.sh 会自动加载。
# ============================================================

# 唤醒短语（英文）。模型只认这个发音；固件提示与服务端前缀剥离会同步替换。
WAKE_WORD="Hi Vesper"

# ASR 近音别名（逗号分隔），服务端剥离唤醒前缀时额外匹配。
# 留空时：Hi Vesper 自动使用中文近音列表，其余唤醒词为空。
# WAKE_WORD_ALIASES="维斯珀,维斯波,维斯帕"

# ---- TTS 数据生成（无需真人录音）----
# wake 类至少 3 个 voice（作为独立 group 防止泄漏）
TTS_WAKE_VOICES="en-US-BrianNeural,en-US-AriaNeural,en-US-JennyNeural,en-US-GuyNeural,en-GB-RyanNeural"
TTS_SAMPLES_PER_VOICE=24
TTS_RATE_VARIANTS="-20,-12,-5,0,5,12,20"
TTS_PITCH_VARIANTS="-20,-10,0,10,20"
TTS_UNKNOWN_VOICES="en-US-BrianNeural,en-US-AriaNeural,en-GB-SoniaNeural"
TTS_UNKNOWN_SENTENCES_PER_VOICE=12
# hard negative 使用独立 voice 池，包含近音短语与自然连续句子。
TTS_HARD_VOICES="en-US-BrianNeural,en-US-AriaNeural,en-US-JennyNeural,en-US-GuyNeural,en-GB-RyanNeural,en-GB-SoniaNeural,en-AU-NatashaNeural,en-IN-PrabhatNeural"
HARD_NEGATIVE_PHRASES="Hey Vesper,Hi Jasper,Hi Casper,Hi Vespa,Hi Esther,Hi Chester,Hi Lester,Hi Hector,Hi Victor,Hi Whisper,My Vesper,Bye Vesper,Hey Whisper,High Jasper,Hi Best Friend"
HARD_SAMPLES_PER_PHRASE=6
HARD_CONTEXT_SENTENCES_PER_VOICE=12
# 没有任何 legacy noise 时合成白/粉/棕噪声兜底
SYNTH_NOISE_IF_EMPTY=1

# ---- 训练参数 ----
EPOCHS=40
BATCH_SIZE=32
HUMAN_REPEAT=8
# 近音/连续 hard negative 在 unknown 类内的权重
HARD_NEGATIVE_REPEAT=4

# ---- 个人录音（可选；留空则全程 TTS，不录也行）----
SPEAKER=hongzhenliang
SESSION=personal-20260815

# ---- 固件构建 ----
# 导出模型后自动 platformio run 编译固件
AUTO_BUILD=1
# 自动烧录（需要 USB 连接、设备在烧录模式）；建议首次手动确认
AUTO_UPLOAD=0
