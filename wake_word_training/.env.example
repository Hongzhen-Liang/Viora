# ============================================================
# Hi Vesper 唤醒词训练流水线配置
# 复制为 .env 后修改；run.sh 会自动加载。
# ============================================================

# 唤醒短语（英文）。模型只认这个发音；固件提示与服务端前缀剥离会同步替换。
WAKE_WORD="Hi Vesper"

# ASR 近音别名（逗号分隔），服务端剥离唤醒前缀时额外匹配。
# 留空时：Hi Vesper 自动使用中文近音列表，其余唤醒词为空。
# WAKE_WORD_ALIASES="维斯珀,维斯波,维斯帕"

# ---- TTS 数据生成（无需真人录音）----
# wake 类至少 3 个 voice（作为独立 group 防止泄漏）
TTS_WAKE_VOICES="en-US-BrianNeural,en-US-AriaNeural,en-US-JennyNeural,en-US-GuyNeural,en-GB-RyanNeural"
TTS_SAMPLES_PER_VOICE=24
TTS_RATE_VARIANTS="-15,-5,0,5,15"
TTS_PITCH_VARIANTS="-10,0,10"
TTS_UNKNOWN_VOICES="en-US-BrianNeural,en-US-AriaNeural,en-GB-SoniaNeural"
TTS_UNKNOWN_SENTENCES_PER_VOICE=12
# 近音负样本（TTS 生成，训练时映射为 unknown）；留空关闭
HARD_NEGATIVE_PHRASES="Hey Vesper,Hi Jasper,Hi Casper"
# 没有任何 legacy noise 时合成白/粉/棕噪声兜底
SYNTH_NOISE_IF_EMPTY=1

# ---- 训练参数 ----
EPOCHS=40
BATCH_SIZE=32
HUMAN_REPEAT=8

# ---- 个人录音（可选；留空则全程 TTS，不录也行）----
SPEAKER=hongzhenliang
SESSION=personal-20260815

# ---- 固件构建 ----
# 导出模型后自动 platformio run 编译固件
AUTO_BUILD=1
# 自动烧录（需要 USB 连接、设备在烧录模式）；建议首次手动确认
AUTO_UPLOAD=0
