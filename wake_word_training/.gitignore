mww/data/
mww/trained_models/
mww/micro-wake-word/
mww/piper-sample-generator/
mww/*.egg-info/

# ---- Python ----
__pycache__/
*.pyc
.pytest_cache/

# ---- 环境 ----
.venv/
.venv-metal/

# ---- 日志 ----
*.log

# ---- macOS ----
.DS_Store
